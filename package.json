{
  "name": "clash-party-custom-override",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "audit": "node scripts/audit.mjs",
    "report": "node scripts/report-generated.mjs",
    "test": "node --test scripts/override.test.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "check:upstream": "node scripts/sync-upstream.mjs --check",
    "check:core": "node scripts/validate-core.mjs",
    "check": "npm run build && npm run audit && npm test && npm run report && node --check dist/Lite-Override.js"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
